CSS_PROVIDER = Gtk.CssProvider()


def apply_css(colors: dict):
    css = build_css(colors)
    CSS_PROVIDER.load_from_data(css.encode("utf-8"))
    Gtk.StyleContext.add_provider_for_display(
        Gdk.Display.get_default(), CSS_PROVIDER,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def picker_cmd():
    env = os.environ.get("PICKER_CMD")
    if env:
        return [env]
    here = Path(__file__).resolve().parent
    for cand in (here / "mpv-wall.py", here / "mpv-wall.sh",
                 here / "mpv-wall", Path.home() / ".local/bin/mpv-wall"):
        if cand.is_file() and os.access(cand, os.X_OK):
            return [str(cand)]
    return ["mpv-wall"]


def rel_of(path: Path) -> str:
    try:
        return str(path.relative_to(WALL_DIR))
    except ValueError:
        return path.name


def thumb_for(src: Path) -> Path | None:
    """Devuelve thumb cacheado (lo genera si falta o es viejo)."""
    THUMB_DIR.mkdir(parents=True, exist_ok=True)
    safe = rel_of(src).replace("/", "_")
    thumb = THUMB_DIR / f"{safe}.thumb.jpg"
    try:
        if thumb.is_file() and thumb.stat().st_mtime >= src.stat().st_mtime:
            return thumb
    except OSError:
        pass
    if shutil.which("magick") is None:
        return thumb_for_ffmpeg(src, thumb)
    name = src.name.lower()
    try:
        if name.endswith(VID_EXTS):
            frame = THUMB_DIR / f"{safe}.frame.jpg"
            r = subprocess.run(
                ["ffmpeg", "-y", "-loglevel", "error", "-ss", "2",
                 "-i", str(src), "-vframes", "1", str(frame)],
                timeout=30)
            if r.returncode != 0 or not frame.is_file():
                return None
            src_img, cleanup = str(frame), True
        elif name.endswith(".gif"):
            src_img, cleanup = f"{src}[0]", False
        else:
            src_img, cleanup = str(src), False
        r = subprocess.run(
            ["magick", src_img, "-resize", f"{THUMB_W}x{THUMB_H}^",
             "-gravity", "Center", "-extent", f"{THUMB_W}x{THUMB_H}",
             str(thumb)],
            timeout=30)
        if cleanup:
            try:
                Path(src_img).unlink()
            except OSError:
                pass
        return thumb if r.returncode == 0 and thumb.is_file() else None
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        return None


def thumb_for_ffmpeg(src: Path, thumb: Path) -> Path | None:
    """Plan B sin ImageMagick: videos/gif vía ffmpeg."""
    name = src.name.lower()
    if not name.endswith(VID_EXTS + (".gif",)):
        return None
    if shutil.which("ffmpeg") is None:
        return None
    vf = (f"scale={THUMB_W}:{THUMB_H}:force_original_aspect_ratio=increase,"
          f"crop={THUMB_W}:{THUMB_H}")
    try:
        for seek in ("2", "0"):
            r = subprocess.run(
                ["ffmpeg", "-y", "-loglevel", "error", "-ss", seek,
                 "-i", str(src), "-vframes", "1", "-vf", vf, str(thumb)],
                timeout=30)
            if r.returncode == 0 and thumb.is_file():
                return thumb
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        pass
    return None


def run_cmd(cmd: list[str], timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


class Picker(Gtk.Window):
    def __init__(self, files: list[Path], loop: GLib.MainLoop, colors: dict):
        super().__init__(title="Fondo de pantalla")
        self.files = files
        self._loop = loop
        self.colors = colors
        self.set_default_size(1200, 800)
        self._applying = False

        apply_css(colors)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        vbox.set_margin_top(16)
        vbox.set_margin_bottom(16)
        vbox.set_margin_start(16)
        vbox.set_margin_end(16)
        self.set_child(vbox)

        # ---------- Header ----------
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        header.set_halign(Gtk.Align.FILL)
        header.set_valign(Gtk.Align.START)

        self.title_lbl = Gtk.Label(label="Fondo de pantalla")
        self.title_lbl.add_css_class("title-label")
        header.append(self.title_lbl)

        header.append(Gtk.Label(label="  "))

        # Ajuste
        ajuste_lbl = Gtk.Label(label="Ajuste:")
        ajuste_lbl.add_css_class("subtitle-label")
        header.append(ajuste_lbl)

        self.btn_centrada = Gtk.ToggleButton(label="Centrada")
        self.btn_centrada.add_css_class("category-button")
        self.btn_centrada.set_active(True)
        header.append(self.btn_centrada)

        self.btn_full = Gtk.ToggleButton(label="Full")
        self.btn_full.add_css_class("category-button")
        header.append(self.btn_full)

        self.btn_estirada = Gtk.ToggleButton(label="Estirada")
        self.btn_estirada.add_css_class("category-button")
        header.append(self.btn_estirada)

        header.append(Gtk.Label(label="  "))

        # Instrucciones
        instr = Gtk.Label()
        instr.set_markup(
            f'<span foreground="{colors["muted"]}" size="small">'
            'Clic: ampliar vista previa &#160;·&#160; '
            'Doble clic: descargar y aplicar fondo</span>')
        header.append(instr)

        vbox.append(header)

        # ---------- Separador ----------
        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        vbox.append(sep)

        # ---------- Pestañas Local / Wallhaven ----------
        tabs_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        tabs_box.set_margin_top(12)
        tabs_box.set_margin_bottom(8)

        self.tab_local = Gtk.ToggleButton(label="Local")
        self.tab_local.add_css_class("tab-button")
        self.tab_local.set_active(True)
        self.tab_local.connect("toggled", self.on_tab_toggled)
        tabs_box.append(self.tab_local)

        self.tab_wh = Gtk.ToggleButton(label="Wallhaven")
        self.tab_wh.add_css_class("tab-button")
        self.tab_wh.connect("toggled", self.on_tab_toggled)
        tabs_box.append(self.tab_wh)

        tabs_box.append(Gtk.Label(label="  "))

        # Botón cerrar
        self.btn_close = Gtk.Button(label="✕")
        self.btn_close.add_css_class("category-button")
        self.btn_close.connect("clicked", lambda _b: self.close())
        tabs_box.append(self.btn_close)

        vbox.append(tabs_box)

        # ---------- Página Local ----------
        self.page_local = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        top_local = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.search_local = Gtk.SearchEntry()
        self.search_local.set_placeholder_text("Buscar wallpapers locales…")
        self.search_local.set_hexpand(True)
        self.search_local.add_css_class("search-entry")
        self.search_local.connect("search-changed", self.on_search_local)
        top_local.append(self.search_local)

        self.count_local = Gtk.Label(label="")
        self.count_local.add_css_class("info-label")
        top_local.append(self.count_local)

        self.page_local.append(top_local)

        scroll_local = Gtk.ScrolledWindow()
        scroll_local.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll_local.set_vexpand(True)
        scroll_local.set_hexpand(True)
        self.page_local.append(scroll_local)

        self.flow_local = Gtk.FlowBox()
        self.flow_local.set_valign(Gtk.Align.START)
        self.flow_local.set_max_children_per_line(4)
        self.flow_local.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.flow_local.connect("child-activated", self.on_activate_local)
        scroll_local.set_child(self.flow_local)

        self.items_local: list[tuple[Gtk.FlowBoxChild, Path, str]] = []
        for f in files:
            child = self.make_item_local(f)
            self.flow_local.append(child)
        self.update_count_local()
        self._pending_local = list(self.items_local)
        GLib.idle_add(self.fill_next_thumb_local)

        # ---------- Página Wallhaven ----------
        self.page_wh = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        # Barra de búsqueda Wallhaven
        top_wh = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.search_wh = Gtk.Entry()
        self.search_wh.set_placeholder_text(
            "Buscar en wallhaven.cc (vacío = populares)…")
        self.search_wh.set_hexpand(True)
        self.search_wh.add_css_class("search-entry")
        self.search_wh.connect("activate", lambda _e: self.on_search_wh())
        top_wh.append(self.search_wh)

        btn_search_wh = Gtk.Button(label="Buscar")
        btn_search_wh.add_css_class("category-button")
        btn_search_wh.connect("clicked", lambda _b: self.on_search_wh())
        top_wh.append(btn_search_wh)

        # Categorías
        cat_lbl = Gtk.Label(label="Categoría:")
        cat_lbl.add_css_class("subtitle-label")
        top_wh.append(cat_lbl)

        self.cat_general = Gtk.ToggleButton(label="General")
        self.cat_general.add_css_class("category-button")
        self.cat_general.set_active(True)
        top_wh.append(self.cat_general)

        self.cat_anime = Gtk.ToggleButton(label="Anime")
        self.cat_anime.add_css_class("category-button")
        top_wh.append(self.cat_anime)

        self.cat_personas = Gtk.ToggleButton(label="Personas")
        self.cat_personas.add_css_class("category-button")
        top_wh.append(self.cat_personas)

        self.page_wh.append(top_wh)

        # Área principal con scroll + panel de tags
        main_wh = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        main_wh.set_hexpand(True)
        main_wh.set_vexpand(True)
        self.page_wh.append(main_wh)

        scroll_wh = Gtk.ScrolledWindow()
        scroll_wh.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll_wh.set_vexpand(True)
        scroll_wh.set_hexpand(True)
        main_wh.append(scroll_wh)

        self.flow_wh = Gtk.FlowBox()
        self.flow_wh.set_valign(Gtk.Align.START)
        self.flow_wh.set_max_children_per_line(4)
        self.flow_wh.set_selection_mode(Gtk.SelectionMode.MULTIPLE)
        self.flow_wh.connect("selected-children-changed",
                             self.on_selection_changed_wh)
        self.flow_wh.connect("child-activated", self.on_activate_wh)
        scroll_wh.set_child(self.flow_wh)

        # Panel lateral de Tags
        self.tags_panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.tags_panel.set_hexpand(False)
        self.tags_panel.set_halign(Gtk.Align.FILL)
        self.tags_panel.add_css_class("tags-panel")

        tags_title = Gtk.Label(label="Tags")
        tags_title.add_css_class("tags-title")
        self.tags_panel.append(tags_title)

        self.tags_flow = Gtk.FlowBox()
        self.tags_flow.set_valign(Gtk.Align.START)
        self.tags_flow.set_max_children_per_line(1)
        self.tags_flow.set_homogeneous(False)
        self.tags_panel.append(self.tags_flow)

        main_wh.append(self.tags_panel)

        # Barra inferior Wallhaven (paginación + descargar)
        bottom_wh = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bottom_wh.set_margin_top(8)

        self.status_wh = Gtk.Label(label="")
        self.status_wh.add_css_class("status-label")
        bottom_wh.append(self.status_wh)

        bottom_wh.append(Gtk.Label(label="  "))

        self.btn_pag_ant = Gtk.ToggleButton(label="〈 Anterior")
        self.btn_pag_ant.add_css_class("pagination-button")
        self.btn_pag_ant.set_sensitive(False)
        self.btn_pag_ant.connect("clicked", self.on_pag_ant)
        bottom_wh.append(self.btn_pag_ant)

        self.pag_lbl = Gtk.Label(label="Página 1 de 1")
        self.pag_lbl.add_css_class("info-label")
        bottom_wh.append(self.pag_lbl)

        self.btn_pag_sig = Gtk.ToggleButton(label="Siguiente 〉")
        self.btn_pag_sig.add_css_class("pagination-button")
        self.btn_pag_sig.connect("clicked", self.on_pag_sig)
        bottom_wh.append(self.btn_pag_sig)

        bottom_wh.append(Gtk.Label(label="  "))
        instr2 = Gtk.Label()
        instr2.set_markup(
            "Flechas: moverse &#160;·&#160; Enter: descargar y aplicar")
        instr2.add_css_class("subtitle-label")
        bottom_wh.append(instr2)

        self.btn_download_wh = Gtk.Button(label="Descargar y aplicar fondo")
        self.btn_download_wh.add_css_class("apply-button")
        self.btn_download_wh.set_sensitive(False)
        self.btn_download_wh.connect("clicked", self.on_download_wh_clicked)
        bottom_wh.append(self.btn_download_wh)

        self.page_wh.append(bottom_wh)

        # ---------- Stack para cambiar de página ----------
        self.stack = Gtk.Stack()
        self.stack.add_titled(self.page_local, "local", "Local")
        self.stack.add_titled(self.page_wh, "wallhaven", "Wallhaven")
        self.stack.set_visible_child_name("local")
        vbox.append(self.stack)

        # Teclado
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        # Estado Wallhaven
        self.result_data_wh = {}  # child -> (full_url, wall_id, ext, resolution)
        self.tags_flow_children = []  # hijos del tags_flow (FlowBox no tiene get_children)
        self.wh_page = 1
        self.wh_query = ""
        self.wh_total = 0

    # ---------- Pestañas ----------

    def on_tab_toggled(self, toggle):
        # Exclusión mutua: solo una pestaña activa a la vez
        if toggle is self.tab_local and self.tab_local.get_active():
            if self.tab_wh.get_active():
                self.tab_wh.set_active(False)
            self.stack.set_visible_child_name("local")
        elif toggle is self.tab_wh and self.tab_wh.get_active():
            if self.tab_local.get_active():
                self.tab_local.set_active(False)
            self.stack.set_visible_child_name("wallhaven")
            # Búsqueda automática de populares al abrir la pestaña Wallhaven
            if not self.result_data_wh:
                GLib.idle_add(self._auto_search_wallhaven)

    def _auto_search_wallhaven(self) -> bool:
        self.on_search_wh()
        return False

    # ---------- Página Local ----------

    def make_item_local(self, path: Path) -> Gtk.FlowBoxChild:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        box.set_margin_start(6)
        box.set_margin_end(6)

        img = Gtk.Picture()
        img.set_size_request(THUMB_W, THUMB_H)
        img.set_content_fit(Gtk.ContentFit.COVER)
        img.add_css_class("thumb-image")
        box.append(img)

        label = Gtk.Label(label=rel_of(path))
        label.set_ellipsize(Pango.EllipsizeMode.END)
        label.set_max_width_chars(22)
        label.add_css_class("info-label")
        box.append(label)

        child = Gtk.FlowBoxChild()
        child.set_child(box)
        self.items_local.append((child, path, rel_of(path).lower()))
        return child

    def fill_next_thumb_local(self):
        for _ in range(3):
            if not self._pending_local:
                return False
            child, path, _ = self._pending_local.pop(0)
            thumb = thumb_for(path)
            src = thumb or path
            try:
                tex = Gdk.Texture.new_from_filename(str(src))
            except GLib.Error:
                tex = None
            if tex is not None:
                w = child.get_child().get_first_child()
                while w is not None:
                    if isinstance(w, Gtk.Picture):
                        w.set_paintable(tex)
                        break
                    w = w.get_next_sibling()
        return True

    def on_search_local(self, _entry):
        self.flow_local.invalidate_filter()
        self.update_count_local()

    def update_count_local(self):
        visible = sum(1 for c, _, _ in self.items_local if c.get_visible())
        self.count_local.set_text(f"{visible}/{len(self.items_local)}")

    def on_activate_local(self, _flow, child):
        self.apply_local(child)

    def apply_local(self, child: Gtk.FlowBoxChild):
        if self._applying:
            return
        for c, path, _ in self.items_local:
            if c is child:
                self._applying = True
                cmd = picker_cmd() + ["set", str(path)]
                env = dict(os.environ)
                if OUTPUT:
                    env["OUTPUT"] = OUTPUT
                try:
                    subprocess.run(cmd, env=env, timeout=120)
                except (OSError, subprocess.SubprocessError):
                    pass
                self._loop.quit()
                return

    # ---------- Página Wallhaven ----------

    def on_search_wh(self):
        query = self.search_wh.get_text().strip()
        cats = self._wh_categories_mask()
        self._do_wallhaven_search(query, cats, page=1)

    def _wh_categories_mask(self) -> str:
        if self.cat_anime.get_active():
            return "010"
        if self.cat_personas.get_active():
            return "001"
        return "100"

    def _do_wallhaven_search(self, query: str, categories: str, page: int):
        self.btn_pag_ant.set_sensitive(False)
        self.btn_pag_sig.set_sensitive(False)
        self.status_wh.set_text("Buscando en wallhaven.cc…")
        for child in list(self.result_data_wh.keys()):
            self.flow_wh.remove(child)
        self.result_data_wh.clear()
        for child in list(self.tags_flow_children):
            self.tags_flow.remove(child)
        self.tags_flow_children.clear()
        self.wh_query = query
        self.wh_page = page
        threading.Thread(
            target=self._do_wallhaven_thread,
            args=(query, categories, page),
            daemon=True).start()

    def _do_wallhaven_thread(self, query: str, categories: str, page: int):
        try:
            results, total, tags, last_page = self._api_search(query, categories, page)
        except Exception as e:
            GLib.idle_add(self._fail_wh, f"Error de red: {e}")
            return

        GLib.idle_add(self._clear_flow_wh)

        if not results:
            GLib.idle_add(self._search_done_wh, 0, total, tags, last_page)
            return

        THUMB_DIR.mkdir(parents=True, exist_ok=True)
        for item in results:
            wall_id = item["id"]
            thumb_url = item["thumb_url"]
            full_url = item["path"]
            resolution = item.get("resolution", "")
            thumb_path = THUMB_DIR / f"wh-preview-{wall_id}.jpg"
            if not (thumb_path.is_file() and thumb_path.stat().st_size > 0):
                self._download_file(thumb_url, thumb_path, timeout=30)
            GLib.idle_add(self._add_result_item_wh,
                          full_url, wall_id, thumb_path, resolution)

        GLib.idle_add(self._search_done_wh, len(results), total, tags, last_page)

    # ---------- Wallhaven helpers (curl) ----------

    def _api_search(self, query: str, categories: str, page: int):
        q = urllib.parse.quote(query, safe="") if query else ""
        url = (f"{WH_API}?q={q}&sorting=relevance&order=desc"
               f"&atleast={WH_RESOLUTION}&ratios=16x9&purity={WH_PURITY}"
               f"&categories={categories}&page={page}&apikey=")
        r = run_cmd(["curl", "-s", "--fail", "--max-time", "30",
                     "-H", "User-Agent: mpv-wall/1.0", url], timeout=35)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or f"curl exited {r.returncode}")
        data = json.loads(r.stdout)
        meta = data.get("meta", {})
        total = meta.get("total", 0)
        last_page = meta.get("last_page", 1)
        tags = meta.get("tags", [])
        results = []
        for it in data.get("data", []):
            path = it.get("path"); i = it.get("id")
            thumbs = it.get("thumbs") or {}
            thumb_url = thumbs.get("original") or thumbs.get("large") or path
            dims = it.get("dimensions") or {}
            resolution = f"{dims.get('width','?')}x{dims.get('height','?')}"
            if path and i:
                results.append({
                    "path": path, "id": str(i),
                    "thumb_url": thumb_url, "resolution": resolution})
        return results, total, tags, last_page

    def _download_file(self, url: str, dst: Path, timeout: int = 60) -> bool:
        try:
            r = run_cmd(["curl", "-sL", "--fail", "--max-time", str(timeout),
                         "-H", "User-Agent: mpv-wall/1.0",
                         "-o", str(dst), url], timeout=timeout + 5)
            return r.returncode == 0 and dst.is_file() and dst.stat().st_size > 0
        except Exception:
            return False

    def _clear_flow_wh(self) -> bool:
        for child in list(self.result_data_wh.keys()):
            self.flow_wh.remove(child)
        self.result_data_wh.clear()
        for child in list(self.tags_flow_children):
            self.tags_flow.remove(child)
        self.tags_flow_children.clear()
        return False

    def _add_result_item_wh(self, full_url: str, wall_id: str,
                            thumb_path: Path, resolution: str) -> bool:
        ext = Path(full_url).suffix or ".jpg"
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_margin_top(6)
        box.set_margin_bottom(6)
        box.set_margin_start(6)
        box.set_margin_end(6)

        img = Gtk.Image()
        img.set_pixel_size(WH_PREVIEW_W)
        img.set_hexpand(True)
        img.add_css_class("thumb-image")
        if thumb_path.is_file() and thumb_path.stat().st_size > 0:
            try:
                img.set_from_file(str(thumb_path))
            except GLib.Error:
                pass
        box.append(img)

        res_label = Gtk.Label(label=resolution)
        res_label.add_css_class("resolution-label")
        res_label.set_halign(Gtk.Align.START)
        box.append(res_label)

        child = Gtk.FlowBoxChild()
        child.set_child(box)
        self.flow_wh.append(child)
        self.result_data_wh[child] = (full_url, wall_id, ext, resolution)
        return False

    def _search_done_wh(self, count: int, total: int, tags: list, last_page: int) -> bool:
        self.status_wh.set_text(f"{count} resultado(s) de wallhaven.cc")

        # Paginación
        self.pag_lbl.set_text(f"Página {self.wh_page} de {last_page}")
        self.btn_pag_ant.set_sensitive(self.wh_page > 1)
        self.btn_pag_sig.set_sensitive(self.wh_page < last_page)

        # Tags
        for t in tags[:12]:
            name = t.get("tag", "")
            btn = Gtk.ToggleButton(label=name)
            btn.add_css_class("tags-button")
            btn.connect("toggled", lambda _b, tag=name: self.on_tag_toggled(tag))
            self.tags_flow.append(btn)
            self.tags_flow_children.append(btn)

        self.btn_download_wh.set_sensitive(
            len(self.flow_wh.get_selected_children()) > 0)
        return False

    def _fail_wh(self, msg: str) -> bool:
        self.status_wh.set_text(msg)
        return False

    def on_selection_changed_wh(self, _flow):
        self.btn_download_wh.set_sensitive(
            len(self.flow_wh.get_selected_children()) > 0)

    def on_activate_wh(self, _flow, child):
        # Doble clic: descargar y aplicar el primero seleccionado
        sel = self.flow_wh.get_selected_children()
        if sel:
            self._download_and_apply_one(sel[0])

    def on_tag_toggled(self, tag: str):
        # Buscar por tag
        self.search_wh.set_text(tag)
        self.on_search_wh()

    def on_pag_ant(self, _button):
        if self.wh_page > 1:
            self._do_wallhaven_search(self.wh_query, self._wh_categories_mask(),
                                      self.wh_page - 1)

    def on_pag_sig(self, _button):
        self._do_wallhaven_search(self.wh_query, self._wh_categories_mask(),
                                  self.wh_page + 1)

    def on_download_wh_clicked(self, _button):
        selected = self.flow_wh.get_selected_children()
        if not selected:
            return
        # Descargar y aplicar el primero
        self._download_and_apply_one(selected[0])

    def _download_and_apply_one(self, child: Gtk.FlowBoxChild):
        if child not in self.result_data_wh:
            return
        full_url, wall_id, ext, _resolution = self.result_data_wh[child]
        self.btn_download_wh.set_sensitive(False)
        self.status_wh.set_text("Descargando y aplicando fondo…")

        def worker():
            WALL_DIR.mkdir(parents=True, exist_ok=True)
            dst = WALL_DIR / f"wallhaven-{wall_id}{ext}"
            ok = False
            if not dst.exists():
                ok = self._download_file(full_url, dst, timeout=60)
                if not ok:
                    try:
                        dst.unlink(missing_ok=True)
                    except Exception:
                        pass
            else:
                ok = True
            GLib.idle_add(self._apply_downloaded, dst if ok else None, wall_id)

        threading.Thread(target=worker, daemon=True).start()

    def _apply_downloaded(self, dst: Path | None, wall_id: str) -> bool:
        if dst is None:
            self.status_wh.set_text("Error descargando el wallpaper")
            self.btn_download_wh.set_sensitive(
                len(self.flow_wh.get_selected_children()) > 0)
            return False
        self.status_wh.set_text(f"wallhaven-{wall_id} aplicado")
        # Refrescar locales
        self.refresh_locals()
        # Aplicar como fondo
        cmd = picker_cmd() + ["set", str(dst)]
        env = dict(os.environ)
        if OUTPUT:
            env["OUTPUT"] = OUTPUT
        try:
            subprocess.run(cmd, env=env, timeout=120)
        except (OSError, subprocess.SubprocessError):
            pass
        self.btn_download_wh.set_sensitive(False)
        return False

    def refresh_locals(self):
        files = sorted(p for p in WALL_DIR.rglob("*")
                       if p.is_file() and p.suffix.lower() in EXTS)
        if not files:
            return False
        self.files = files
        for child, _, _ in list(self.items_local):
            self.flow_local.remove(child)
        self.items_local.clear()
        for f in files:
            child = self.make_item_local(f)
            self.flow_local.append(child)
        self.update_count_local()
        self._pending_local = list(self.items_local)
        GLib.idle_add(self.fill_next_thumb_local)
        return False

    # ---------- Teclado ----------

    def on_key(self, _ctrl, keyval, _keycode, _state):
        if self.stack.get_visible_child_name() != "wallhaven":
            return False
        if keyval in (Gdk.KEY_Left, Gdk.KEY_KP_Left):
            self.on_pag_ant(None)
            return True
        if keyval in (Gdk.KEY_Right, Gdk.KEY_KP_Right):
            self.on_pag_sig(None)
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            sel = self.flow_wh.get_selected_children()
            if sel:
                self._download_and_apply_one(sel[0])
            return True
        return False


def main(argv: list[str]) -> int:
    global OUTPUT
    args = iter(argv[1:])
    for a in args:
        if a in ("-o", "--output"):
            OUTPUT = next(args, "")
        elif a in ("-h", "--help"):
            print("Uso: wall-picker.py [-o <salida>]")
            return 0
        else:
            print(f"Flag desconocido: {a}", file=sys.stderr)
            return 1
    if not WALL_DIR.is_dir():
        print(f"Sin fondos en {WALL_DIR}", file=sys.stderr)
        return 1
    files = sorted(p for p in WALL_DIR.rglob("*")
                   if p.is_file() and p.suffix.lower() in EXTS)
    if not files:
        print(f"Sin fondos en {WALL_DIR} (y subcarpetas)", file=sys.stderr)
        return 1
    colors = load_matugen_colors()
    loop = GLib.MainLoop()
    win = Picker(files, loop, colors)
    win.connect("close-request", lambda *_: (loop.quit(), False)[1])
    win.present()
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
