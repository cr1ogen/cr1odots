#!/usr/bin/env python3
# Selector visual de wallpapers (GTK4) para mpv-wall.
# Diseño basado en wallhaven.cc: tema oscuro, pestañas Local/Wallhaven,
# grid de miniaturas, panel de Tags, paginación y controles de ajuste.
# Los colores se toman de matugen (~/.config/gtk-4.0/gtk.css).
# Uso: wall-picker.py [-o <salida>]
# Env: WALL_DIR, OUTPUT, THUMB_DIR, THUMB_W, THUMB_H, PICKER_CMD
"""GTK wallpaper picker for mpv-wall (wallhaven-style UI, matugen colors)."""

