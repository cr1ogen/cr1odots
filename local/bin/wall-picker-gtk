WH_LIMIT = int(os.environ.get("WH_LIMIT", "24"))
WH_PREVIEW_W = int(os.environ.get("WH_PREVIEW_W", "240"))
WH_PREVIEW_H = int(os.environ.get("WH_PREVIEW_H", "135"))

# ---------- Colores de matugen desde ~/.config/gtk-4.0/gtk.css ----------
MATUGEN_GTK_CSS = Path.home() / ".config/gtk-4.0/gtk.css"


def load_matugen_colors() -> dict:
    """Lee los colores dark de ~/.config/gtk-4.0/gtk.css generados por matugen."""
    defaults = {
        "bg": "#191112",
        "fg": "#efdfde",
        "accent": "#ffb3b5",
        "surface": "#261d1e",
        "surface_hover": "#663e3f",
        "muted": "#dac1c0",
        "border": "#877272",
    }
    try:
        if MATUGEN_GTK_CSS.is_file():
            text = MATUGEN_GTK_CSS.read_text()
            # Extraer solo el bloque @media (prefers-color-scheme: dark)
            dark_match = re.search(
                r'@media\s*\(prefers-color-scheme:\s*dark\)\s*\{(.*?)\n\}', text, re.DOTALL)
            if dark_match:
                block = dark_match.group(1)
            else:
                block = text
            # Buscar @define-color nombre #hex o rgba(...)
            colors = {}
            for m in re.finditer(
                    r'@define-color\s+(\w+)\s+#([0-9a-fA-F]{6});', block):
                name = m.group(1)
                hexval = "#" + m.group(2)
                colors[name] = hexval
            # Mapear nombres de matugen a nuestros roles
            bg = colors.get("window_bg_color", defaults["bg"])
            fg = colors.get("window_fg_color", defaults["fg"])
            accent = colors.get("accent_color", defaults["accent"])
            surface = colors.get("card_bg_color", defaults["surface"])
            surface_hover = colors.get(
                "sidebar_row_active_bg_color", defaults["surface_hover"])
            muted = colors.get("secondary_sidebar_fg_color", defaults["muted"])
            border = colors.get("outline", defaults["border"])
            return {
                "bg": bg, "fg": fg, "accent": accent,
                "surface": surface, "surface_hover": surface_hover,
                "muted": muted, "border": border,
            }
    except Exception:
        pass
    return defaults


