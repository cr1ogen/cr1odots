#!/usr/bin/env python3
# Selector visual de wallpapers (GTK4) para mpv-wall.
# Busca recursivo en WALL_DIR, thumbs 16:9 cacheados en THUMB_DIR
# (mismo cache que el viejo wall-picker.sh, compartido).
# Uso: wall-picker.py [-o <salida>]
# Env: WALL_DIR, OUTPUT, THUMB_DIR, THUMB_W, THUMB_H, PICKER_CMD
"""GTK wallpaper picker for mpv-wall (recursive, cached 16:9 thumbs)."""

import json
import os
import shutil
import subprocess
import sys
import threading
import urllib.parse
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Pango  # noqa: E402

WALL_DIR = Path(os.environ.get("WALL_DIR", str(Path.home() / "Imágenes/wallpapers")))
THUMB_DIR = Path(os.environ.get("THUMB_DIR", str(Path.home() / ".cache/mpv-wall-thumbs")))
THUMB_W = int(os.environ.get("THUMB_W", "320"))
THUMB_H = int(os.environ.get("THUMB_H", "180"))
OUTPUT = os.environ.get("OUTPUT", "")
EXTS = (".jpg", ".jpeg", ".png", ".webp", ".gif", ".mp4", ".webm", ".mkv")
VID_EXTS = (".mp4", ".webm", ".mkv")
# Wallhaven.cc
WH_API = "https://wallhaven.cc/api/v1/search"
WH_PURITY = os.environ.get("WH_PURITY", "sfw")
WH_CATEGORIES = os.environ.get("WH_CATEGORIES", "100")  # 100=general, 010=anime, 001=people
WH_RESOLUTION = os.environ.get("WH_RESOLUTION", "1920x1080")
WH_LIMIT = int(os.environ.get("WH_LIMIT", "5"))
WH_PREVIEW_W = int(os.environ.get("WH_PREVIEW_W", "240"))
WH_PREVIEW_H = int(os.environ.get("WH_PREVIEW_H", "135"))


def picker_cmd():
    env = os.environ.get("PICKER_CMD")
    if env:
        return [env]
    here = Path(__file__).resolve().parent
    for cand in (here / "mpv-wall.py", here / "mpv-wall.sh",
                 here / "mpv-wall", Path.home() / ".local/bin/mpv-wall"):
        if cand.is_file() and os.access(cand, os.X_OK):
            return [str(cand)]
    return ["mpv-wall"]


def rel_of(path: Path) -> str:
    try:
        return str(path.relative_to(WALL_DIR))
    except ValueError:
        return path.name


def thumb_for(src: Path) -> Path | None:
    """Devuelve thumb 320x180 cacheado (lo genera si falta o es viejo)."""
    THUMB_DIR.mkdir(parents=True, exist_ok=True)
    safe = rel_of(src).replace("/", "_")
    thumb = THUMB_DIR / f"{safe}.thumb.jpg"
    try:
        if thumb.is_file() and thumb.stat().st_mtime >= src.stat().st_mtime:
            return thumb
    except OSError:
        pass
    if shutil.which("magick") is None:
        return thumb_for_ffmpeg(src, thumb)
    name = src.name.lower()
    try:
        if name.endswith(VID_EXTS):
            frame = THUMB_DIR / f"{safe}.frame.jpg"
            r = subprocess.run(
                ["ffmpeg", "-y", "-loglevel", "error", "-ss", "2",
                 "-i", str(src), "-vframes", "1", str(frame)],
                timeout=30)
            if r.returncode != 0 or not frame.is_file():
                return None
            src_img, cleanup = str(frame), True
        elif name.endswith(".gif"):
            src_img, cleanup = f"{src}[0]", False
        else:
            src_img, cleanup = str(src), False
        r = subprocess.run(
            ["magick", src_img, "-resize", f"{THUMB_W}x{THUMB_H}^",
             "-gravity", "Center", "-extent", f"{THUMB_W}x{THUMB_H}",
             str(thumb)],
            timeout=30)
        if cleanup:
            try:
                Path(src_img).unlink()
            except OSError:
                pass
        return thumb if r.returncode == 0 and thumb.is_file() else None
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        return None


def thumb_for_ffmpeg(src: Path, thumb: Path) -> Path | None:
    """Plan B sin ImageMagick: videos/gif vía ffmpeg con scale+crop.

    Imágenes fijas devuelven None a propósito: el llamador ya las
    carga directo con GdkPixbuf (sin caché, pero se ven).
    """
    name = src.name.lower()
    if not name.endswith(VID_EXTS + (".gif",)):
        return None
    if shutil.which("ffmpeg") is None:
        return None
    vf = (f"scale={THUMB_W}:{THUMB_H}:force_original_aspect_ratio=increase,"
          f"crop={THUMB_W}:{THUMB_H}")
    try:
        # -ss 2 falla en clips más cortos: reintento desde el inicio.
        for seek in ("2", "0"):
            r = subprocess.run(
                ["ffmpeg", "-y", "-loglevel", "error", "-ss", seek,
                 "-i", str(src), "-vframes", "1", "-vf", vf, str(thumb)],
                timeout=30)
            if r.returncode == 0 and thumb.is_file():
                return thumb
    except (OSError, subprocess.SubprocessError, subprocess.TimeoutExpired):
        pass
    return None


def run_cmd(cmd: list[str], timeout: int = 60) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


class Picker(Gtk.Window):
    def __init__(self, files: list[Path], loop: GLib.MainLoop):
        super().__init__(title="Wallpapers")
        self.files = files
        self._loop = loop
        self.set_default_size(1200, 750)
        self._applying = False

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for m in ("margin_top", "margin_bottom",
                  "margin_start", "margin_end"):
            vbox.set_property(m, 10)
        self.set_child(vbox)

        # Notebook con dos pestañas: Locales y Wallhaven
        self.notebook = Gtk.Notebook()
        vbox.append(self.notebook)

        # ---------- Página 1: Locales ----------
        local_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for m in ("margin_top", "margin_bottom",
                  "margin_start", "margin_end"):
            local_page.set_property(m, 8)

        top_local = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.search_local = Gtk.SearchEntry(placeholder_text=" Buscar wallpaper…")
        self.search_local.set_hexpand(True)
        self.search_local.connect("search-changed", self.on_search_local)
        top_local.append(self.search_local)

        self.count_local = Gtk.Label()
        top_local.append(self.count_local)
        local_page.append(top_local)

        scroll_local = Gtk.ScrolledWindow()
        scroll_local.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll_local.set_vexpand(True)
        scroll_local.set_hexpand(True)
        local_page.append(scroll_local)

        self.flow_local = Gtk.FlowBox()
        self.flow_local.set_valign(Gtk.Align.START)
        self.flow_local.set_max_children_per_line(3)
        self.flow_local.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.flow_local.set_filter_func(self.filter_func_local)
        self.flow_local.connect("child-activated", self.on_activate_local)
        scroll_local.set_child(self.flow_local)

        self.items_local: list[tuple[Gtk.FlowBoxChild, Path, str]] = []
        for f in files:
            child = self.make_item_local(f)
            self.flow_local.append(child)
        self.update_count_local()
        self._pending_local = list(self.items_local)
        GLib.idle_add(self.fill_next_thumb_local)

        self.notebook.append_page(local_page, Gtk.Label(label="Locales"))

        # ---------- Página 2: Wallhaven ----------
        wh_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for m in ("margin_top", "margin_bottom",
                  "margin_start", "margin_end"):
            wh_page.set_property(m, 8)

        # fila de búsqueda Wallhaven
        top_wh = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.search_wh = Gtk.Entry()
        self.search_wh.set_placeholder_text("Ej: nature, anime, cyberpunk…")
        self.search_wh.set_hexpand(True)
        top_wh.append(self.search_wh)

        self.btn_search_wh = Gtk.Button(label="Buscar")
        self.btn_search_wh.connect("clicked", self.on_search_wh_clicked)
        top_wh.append(self.btn_search_wh)

        row_wh = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row_wh.append(Gtk.Label(label="Límite:"))
        self.limit_wh = Gtk.SpinButton()
        self.limit_wh.set_range(1, 30)
        self.limit_wh.set_value(WH_LIMIT)
        self.limit_wh.set_numeric(True)
        row_wh.append(self.limit_wh)
        top_wh.append(row_wh)
        wh_page.append(top_wh)

        # resultados con preview (selección múltiple)
        scroll_wh = Gtk.ScrolledWindow()
        scroll_wh.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll_wh.set_vexpand(True)
        scroll_wh.set_hexpand(True)
        wh_page.append(scroll_wh)

        self.flow_wh = Gtk.FlowBox()
        self.flow_wh.set_valign(Gtk.Align.START)
        self.flow_wh.set_max_children_per_line(4)
        self.flow_wh.set_selection_mode(Gtk.SelectionMode.MULTIPLE)
        self.flow_wh.connect("selected-children-changed",
                             self.on_selection_changed_wh)
        scroll_wh.set_child(self.flow_wh)

        self.status_wh = Gtk.Label(label="")
        self.status_wh.set_hexpand(True)
        wh_page.append(self.status_wh)

        # barra de botones
        btns_wh = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btns_wh.set_halign(Gtk.Align.END)
        self.btn_download_wh = Gtk.Button(label="Descargar seleccionados")
        self.btn_download_wh.add_css_class("suggested-action")
        self.btn_download_wh.set_sensitive(False)
        self.btn_download_wh.connect("clicked", self.on_download_wh_clicked)
        btns_wh.append(self.btn_download_wh)
        wh_page.append(btns_wh)

        self.notebook.append_page(wh_page, Gtk.Label(label="Wallhaven"))

        self.result_data_wh = {}  # child -> (full_url, wall_id, ext)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

    # ---------- Página Locales ----------

    def make_item_local(self, path: Path) -> Gtk.FlowBoxChild:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        for m in ("margin_top", "margin_bottom",
                  "margin_start", "margin_end"):
            box.set_property(m, 6)
        img = Gtk.Picture()
        img.set_size_request(THUMB_W, THUMB_H)
        img.set_content_fit(Gtk.ContentFit.CONTAIN)
        box.append(img)
        label = Gtk.Label(label=rel_of(path))
        label.set_ellipsize(Pango.EllipsizeMode.END)
        label.set_max_width_chars(28)
        label.add_css_class("dim-label")
        box.append(label)
        child = Gtk.FlowBoxChild()
        child.set_child(box)
        self.items_local.append((child, path, rel_of(path).lower()))
        return child

    def fill_next_thumb_local(self):
        for _ in range(3):
            if not self._pending_local:
                return False
            child, path, _ = self._pending_local.pop(0)
            thumb = thumb_for(path)
            src = thumb or path
            try:
                tex = Gdk.Texture.new_from_filename(str(src))
            except GLib.Error:
                tex = None
            if tex is not None:
                w = child.get_child().get_first_child()
                while w is not None:
                    if isinstance(w, Gtk.Picture):
                        w.set_paintable(tex)
                        break
                    w = w.get_next_sibling()
        return True

    def filter_func_local(self, child: Gtk.FlowBoxChild) -> bool:
        q = self.search_local.get_text().lower().strip()
        if not q:
            return True
        for c, _, rel in self.items_local:
            if c is child:
                return q in rel
        return True

    def on_search_local(self, _entry):
        self.flow_local.invalidate_filter()
        self.update_count_local()

    def update_count_local(self):
        visible = sum(1 for c, _, _ in self.items_local if c.get_visible())
        self.count_local.set_text(f"{visible}/{len(self.items_local)}")

    def on_key(self, _ctrl, keyval, _keycode, _state):
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            sel = self.flow_local.get_selected_children()
            if sel:
                self.apply_local(sel[0])
                return True
        return False

    def on_activate_local(self, _flow, child):
        self.apply_local(child)

    def apply_local(self, child: Gtk.FlowBoxChild):
        if self._applying:
            return
        for c, path, _ in self.items_local:
            if c is child:
                self._applying = True
                cmd = picker_cmd() + ["set", str(path)]
                env = dict(os.environ)
                if OUTPUT:
                    env["OUTPUT"] = OUTPUT
                try:
                    subprocess.run(cmd, env=env, timeout=120)
                except (OSError, subprocess.SubprocessError):
                    pass
                self._loop.quit()
                return

    def refresh_locals(self):
        """Vuelve a escanear WALL_DIR y reconstruye la pestaña Locales."""
        files = sorted(p for p in WALL_DIR.rglob("*")
                       if p.is_file() and p.suffix.lower() in EXTS)
        if not files:
            return False
        self.files = files
        for child, _, _ in list(self.items_local):
            self.flow_local.remove(child)
        self.items_local.clear()
        for f in files:
            child = self.make_item_local(f)
            self.flow_local.append(child)
        self.update_count_local()
        self._pending_local = list(self.items_local)
        GLib.idle_add(self.fill_next_thumb_local)
        return False

    # ---------- Página Wallhaven ----------

    def on_search_wh_clicked(self, _button):
        query = self.search_wh.get_text().strip()
        if not query:
            self.status_wh.set_text("Escribe una búsqueda.")
            return
        self.btn_search_wh.set_sensitive(False)
        self.btn_download_wh.set_sensitive(False)
        self.status_wh.set_text("Buscando en wallhaven.cc…")
        for child in list(self.result_data_wh.keys()):
            self.flow_wh.remove(child)
        self.result_data_wh.clear()
        limit = int(self.limit_wh.get_value())
        threading.Thread(target=self._do_wallhaven,
                         args=(query, limit), daemon=True).start()

    def on_selection_changed_wh(self, _flow):
        self.btn_download_wh.set_sensitive(
            len(self.flow_wh.get_selected_children()) > 0)

    def on_download_wh_clicked(self, _button):
        selected = self.flow_wh.get_selected_children()
        if not selected:
            return
        self.btn_download_wh.set_sensitive(False)
        self.status_wh.set_text("Descargando seleccionados…")
        items = [self.result_data_wh[c] for c in selected
                 if c in self.result_data_wh]
        threading.Thread(target=self._download_selected_wh,
                         args=(items,), daemon=True).start()

    # ---------- Wallhaven helpers (curl) ----------

    def _api_search(self, query: str, limit: int) -> list[dict]:
        q = urllib.parse.quote(query, safe="")
        url = (f"{WH_API}?q={q}&sorting=relevance&order=desc"
               f"&atleast={WH_RESOLUTION}&ratios=16x9&purity={WH_PURITY}"
               f"&categories={WH_CATEGORIES}&apikey=")
        r = run_cmd(["curl", "-s", "--fail", "--max-time", "30",
                     "-H", "User-Agent: mpv-wall/1.0", url], timeout=35)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or f"curl exited {r.returncode}")
        data = json.loads(r.stdout)
        results = []
        for it in data.get("data", [])[:limit]:
            path = it.get("path"); i = it.get("id")
            thumbs = it.get("thumbs") or {}
            thumb_url = thumbs.get("original") or thumbs.get("large") or path
            if path and i:
                results.append({"path": path, "id": str(i), "thumb_url": thumb_url})
        return results

    def _download_file(self, url: str, dst: Path, timeout: int = 60) -> bool:
        try:
            r = run_cmd(["curl", "-sL", "--fail", "--max-time", str(timeout),
                         "-H", "User-Agent: mpv-wall/1.0",
                         "-o", str(dst), url], timeout=timeout + 5)
            return r.returncode == 0 and dst.is_file() and dst.stat().st_size > 0
        except Exception:
            return False

    def _do_wallhaven(self, query: str, limit: int):
        try:
            results = self._api_search(query, limit)
        except Exception as e:
            GLib.idle_add(self._fail_wh, f"Error de red: {e}")
            return

        GLib.idle_add(self._clear_flow_wh)

        if not results:
            GLib.idle_add(self._search_done_wh, 0)
            return

        THUMB_DIR.mkdir(parents=True, exist_ok=True)
        for item in results:
            wall_id = item["id"]
            thumb_url = item["thumb_url"]
            thumb_path = THUMB_DIR / f"wh-preview-{wall_id}.jpg"
            if not (thumb_path.is_file() and thumb_path.stat().st_size > 0):
                self._download_file(thumb_url, thumb_path, timeout=30)
            GLib.idle_add(self._add_result_item_wh,
                          item["path"], wall_id, thumb_path)

        GLib.idle_add(self._search_done_wh, len(results))

    def _clear_flow_wh(self) -> bool:
        for child in list(self.result_data_wh.keys()):
            self.flow_wh.remove(child)
        self.result_data_wh.clear()
        return False

    def _add_result_item_wh(self, full_url: str, wall_id: str,
                            thumb_path: Path) -> bool:
        ext = Path(full_url).suffix or ".jpg"
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        for m in ("margin_top", "margin_bottom", "margin_start", "margin_end"):
            box.set_property(m, 4)

        img = Gtk.Image()
        img.set_pixel_size(WH_PREVIEW_W)
        img.set_hexpand(True)
        if thumb_path.is_file() and thumb_path.stat().st_size > 0:
            try:
                img.set_from_file(str(thumb_path))
            except GLib.Error:
                pass
        box.append(img)

        label = Gtk.Label(label=f"wallhaven-{wall_id}")
        label.set_ellipsize(Pango.EllipsizeMode.END)
        label.set_max_width_chars(18)
        label.add_css_class("dim-label")
        box.append(label)

        child = Gtk.FlowBoxChild()
        child.set_child(box)
        self.flow_wh.append(child)
        self.result_data_wh[child] = (full_url, wall_id, ext)
        return False

    def _search_done_wh(self, count: int) -> bool:
        self.btn_search_wh.set_sensitive(True)
        self.status_wh.set_text(f"{count} resultado(s) de wallhaven.cc")
        self.btn_download_wh.set_sensitive(
            len(self.flow_wh.get_selected_children()) > 0)
        return False

    def _fail_wh(self, msg: str) -> bool:
        self.status_wh.set_text(msg)
        self.btn_search_wh.set_sensitive(True)
        return False

    def _download_selected_wh(self, items: list[tuple[str, str, str]]):
        WALL_DIR.mkdir(parents=True, exist_ok=True)
        saved = 0
        for full_url, wall_id, ext in items:
            dst = WALL_DIR / f"wallhaven-{wall_id}{ext}"
            if dst.exists():
                continue
            if self._download_file(full_url, dst, timeout=60):
                saved += 1
            else:
                try:
                    dst.unlink(missing_ok=True)
                except Exception:
                    pass
        GLib.idle_add(self._finished_wh, saved)

    def _finished_wh(self, saved: int) -> bool:
        self.status_wh.set_text(f"Descargado(s): {saved}")
        self.refresh_locals()
        return False


def main(argv: list[str]) -> int:
    global OUTPUT
    args = iter(argv[1:])
    for a in args:
        if a in ("-o", "--output"):
            OUTPUT = next(args, "")
        elif a in ("-h", "--help"):
            print("Uso: wall-picker.py [-o <salida>]")
            return 0
        else:
            print(f"Flag desconocido: {a}", file=sys.stderr)
            return 1
    if not WALL_DIR.is_dir():
        print(f"Sin fondos en {WALL_DIR}", file=sys.stderr)
        return 1
    files = sorted(p for p in WALL_DIR.rglob("*")
                   if p.is_file() and p.suffix.lower() in EXTS)
    if not files:
        print(f"Sin fondos en {WALL_DIR} (y subcarpetas)", file=sys.stderr)
        return 1
    loop = GLib.MainLoop()
    win = Picker(files, loop)
    win.connect("close-request", lambda *_: (loop.quit(), False)[1])
    win.present()
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
