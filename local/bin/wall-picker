#!/usr/bin/env bash
# Selector visual de wallpapers para mpvpaper.
# Usa rofi con miniaturas (imágenes + videos) y cae a zenity si rofi falla.
# Uso: wall-picker.sh [--rofi|--zenity] [-o <salida>]
# Env: WALL_DIR, OUTPUT, THUMB_DIR, PICKER_CMD (mpv-wall.sh)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WALL_DIR="${WALL_DIR:-$HOME/Imágenes/wallpapers}"
THUMB_DIR="${THUMB_DIR:-$HOME/.cache/mpv-wall-thumbs}"
PICKER_CMD="${PICKER_CMD:-}"
if [[ -z "$PICKER_CMD" ]]; then
    if [[ -x "$SCRIPT_DIR/mpv-wall.sh" ]]; then PICKER_CMD="$SCRIPT_DIR/mpv-wall.sh"
    elif [[ -x "$SCRIPT_DIR/mpv-wall" ]]; then PICKER_CMD="$SCRIPT_DIR/mpv-wall"
    else PICKER_CMD="mpv-wall"
    fi
fi
OUTPUT="${OUTPUT:-}"
MODE="auto"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --rofi) MODE="rofi"; shift ;;
        --zenity) MODE="zenity"; shift ;;
        -o|--output) OUTPUT="$2"; shift 2 ;;
        -h|--help) sed -n '2,5p' "$0"; echo "Flags: --rofi | --zenity | -o <salida>"; exit 0 ;;
        *) echo "Flag desconocido: $1" >&2; exit 1 ;;
    esac
done

mapfile -t FILES < <(find "$WALL_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' \) | sort)
[[ ${#FILES[@]} -gt 0 ]] || { echo "Sin fondos en $WALL_DIR (y subcarpetas)" >&2; exit 1; }
mkdir -p "$THUMB_DIR"

# Ruta relativa a WALL_DIR para mostrar (evita choques de nombres)
rel_of() {
    local f="$1"
    if [[ "$f" == "$WALL_DIR/"* ]]; then echo "${f#$WALL_DIR/}"
    else basename "$f"; fi
}

# Miniatura panorámica 16:9 (320x180) para rofi estilo JaKooLit. Cacheada por mtime.
THUMB_W="${THUMB_W:-320}"
THUMB_H="${THUMB_H:-180}"
thumb_for() {
    local f="$1" rel safe t
    rel="$(rel_of "$f")"
    safe="${rel//\//_}"
    t="$THUMB_DIR/$safe.thumb.jpg"
    if [[ -f "$t" && "$t" -nt "$f" ]]; then echo "$t"; return 0; fi
    case "${f,,}" in
        *.mp4|*.webm|*.mkv)
            command -v ffmpeg >/dev/null || return 1
            local frame="$THUMB_DIR/$safe.frame.jpg"
            ffmpeg -y -loglevel error -ss 2 -i "$f" -vframes 1 "$frame" 2>/dev/null || return 1
            if command -v magick >/dev/null 2>&1; then
                magick "$frame" -resize "${THUMB_W}x${THUMB_H}^" -gravity Center -extent "${THUMB_W}x${THUMB_H}" "$t" 2>/dev/null || return 1
                rm -f "$frame"
            else
                ffmpeg -y -loglevel error -i "$frame" -vf "scale=${THUMB_W}:${THUMB_H}:force_original_aspect_ratio=increase,crop=${THUMB_W}:${THUMB_H}" "$t" 2>/dev/null || return 1
                rm -f "$frame"
            fi
            ;;
        *)
            # GIF: primer frame para que el thumb sea jpg estático
            local src="$f"
            case "${f,,}" in *.gif) src="$f[0]" ;; esac
            if command -v magick >/dev/null 2>&1; then
                magick "$src" -resize "${THUMB_W}x${THUMB_H}^" -gravity Center -extent "${THUMB_W}x${THUMB_H}" "$t" 2>/dev/null || { echo "$f"; return 0; }
            else
                echo "$f"; return 0
            fi
            ;;
    esac
    echo "$t"
}

pick_rofi() {
    command -v rofi >/dev/null || return 1
    local sel f t base cols theme
    theme="${WALLPAPER_THEME:-$HOME/.config/rofi/wallpaper-selector.rasi}"
    [[ -f "$theme" ]] || theme="$SCRIPT_DIR/rofi-wallpaper-selector.rasi"
    cols=${#FILES[@]}
    (( cols > 6 )) && cols=6
    (( cols < 1 )) && cols=1
    # Filas justas para no dejar banda vacía abajo (máx 2 como el tema)
    rows=$(( (${#FILES[@]} + cols - 1) / cols ))
    (( rows > 2 )) && rows=2
    (( rows < 1 )) && rows=1
    # NUL (\0) no puede vivir en variables bash: se genera con printf directo al pipe
    # Estilo gh0stzk: grilla de miniaturas, sin inputbar (ver rofi-wallpaper-selector.rasi)
    sel=$(for f in "${FILES[@]}"; do
        t="$(thumb_for "$f" || echo "$f")"
        printf '%s\0icon\x1f%s\n' "$(rel_of "$f")" "$t"
    done | rofi -dmenu -i -p "" -show-icons -theme "$theme" -theme-str "listview {columns: $cols; lines: $rows;}" || true)
    [[ -n "$sel" ]] || exit 0  # Esc = cancelar
    # rofi devuelve la ruta relativa; resolver a ruta completa
    for f in "${FILES[@]}"; do
        [[ "$(rel_of "$f")" == "$sel" ]] && { echo "$f"; return 0; }
    done || true
    echo "No match: $sel" >&2; return 1
}

pick_zenity() {
    command -v zenity >/dev/null || { echo "Ni rofi ni zenity disponibles" >&2; return 1; }
    zenity --file-selection --title="Elegí wallpaper" --filename="$WALL_DIR/" \
        --file-filter="Fondos | *.jpg *.jpeg *.png *.webp *.gif *.mp4 *.webm *.mkv" 2>/dev/null || exit 0
}

CHOSEN=""
case "$MODE" in
    rofi) CHOSEN="$(pick_rofi)" ;;
    zenity) CHOSEN="$(pick_zenity)" ;;
    *) CHOSEN="$(pick_rofi || pick_zenity)" ;;
esac
[[ -n "$CHOSEN" && -f "$CHOSEN" ]] || { echo "Selección inválida" >&2; exit 1; }

if [[ -n "$OUTPUT" ]]; then
    OUTPUT="$OUTPUT" "$PICKER_CMD" set "$CHOSEN"
else
    "$PICKER_CMD" set "$CHOSEN"
fi
