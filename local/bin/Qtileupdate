#!/bin/zsh

cd /home/cr1ogen/Git/qtile || exit 1
git pull

# En Zsh puedes poner el mensaje directamente dentro del prompt de read
read "respuesta?¿Quieres actualizar Qtile? [S/n] "

case $respuesta in
    [Ss]* | "" )  # Captura S, s, o Enter (cadena vacía)
        echo "Actualizando Qtile..."
        su -c "pip install --config-setting backend=wayland . --break-system-packages"
        qtile cmd-obj -o cmd -f reload_config
        echo "Qtile está actualizado."
        ;;

    [Nn]* ) 
        echo "Operación cancelada por el usuario."
        exit 0
        ;;

    * ) 
        echo "Respuesta no válida. Por favor, escribe s o n."
        exit 1
        ;;
esac
