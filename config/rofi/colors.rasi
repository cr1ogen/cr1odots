    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #1d100e;
    on-surface: #f8dcd9;
    on-surface-variant: #e2beba;
    outline: #a98986;
    outline-variant: #5a413e;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f8dcd9;
    inverse-on-surface: #3d2c2b;
    inverse-primary: #b42724;
    surface-dim: #1d100e;
    surface-bright: #463533;
    surface-container-lowest: #170b09;
    surface-container-low: #261816;
    surface-container: #2b1c1a;
    surface-container-high: #362624;
    surface-container-highest: #41312f;
