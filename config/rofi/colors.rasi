    on-primary: #690006;
    on-primary-fixed: #410002;
    on-primary-fixed-variant: #91080f;
    primary-container: #fa5a50;
    on-primary-container: #000000;
    secondary: #ffb4ab;
    secondary-fixed: #ffdad6;
    secondary-fixed-dim: #ffb4ab;
    on-secondary: #5c1815;
    on-secondary-fixed: #3f0304;
    on-secondary-fixed-variant: #7a2e28;
    secondary-container: #7a2e28;
    on-secondary-container: #ffd7d2;
    tertiary: #ffb956;
    tertiary-fixed: #ffddb5;
    tertiary-fixed-dim: #ffb956;
    on-tertiary: #452b00;
    on-tertiary-fixed: #2a1800;
    on-tertiary-fixed-variant: #633f00;
    tertiary-container: #c58312;
    on-tertiary-container: #000000;
