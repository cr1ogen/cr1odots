import os
from typing import cast

from fabric import Application
from fabric.widgets.box import Box
from fabric.widgets.label import Label
from fabric.widgets.image import Image
from fabric.widgets.button import Button
from fabric.widgets.wayland import WaylandWindow as Window
from fabric.notifications import Notifications, Notification
from fabric.utils import invoke_repeater, get_relative_path

from gi.repository import GdkPixbuf

NOTIFICATION_WIDTH = 360
NOTIFICATION_IMAGE_SIZE = 64
NOTIFICATION_TIMEOUT = 10 * 1000  # 10 segundos


class NotificationWidget(Box):
    def __init__(self, notification: Notification, **kwargs):
        super().__init__(
            size=(NOTIFICATION_WIDTH, -1),
            name="notification",
            spacing=8,
            orientation="v",
            **kwargs,
        )

        self._notification = notification
        body_container = Box(spacing=8, orientation="h")

        # --- SOPORTE DE IMÁGENES / MINIATURAS ---
        if image_pixbuf := self._notification.image_pixbuf:
            body_container.add(
                Image(
                    pixbuf=image_pixbuf.scale_simple(
                        NOTIFICATION_IMAGE_SIZE,
                        NOTIFICATION_IMAGE_SIZE,
                        GdkPixbuf.InterpType.BILINEAR,
                    )
                )
            )
        elif self._notification.icon and os.path.exists(self._notification.icon):
            body_container.add(
                Image(
                    file_path=self._notification.icon,
                    size=NOTIFICATION_IMAGE_SIZE,
                )
            )
        elif self._notification.icon:
            body_container.add(
                Image(
                    icon_name=self._notification.icon,
                    icon_size=NOTIFICATION_IMAGE_SIZE,
                )
            )

        body_container.add(
            Box(
                spacing=4,
                orientation="v",
                children=[
                    Box(
                        orientation="h",
                        children=[
                            Label(
                                label=self._notification.summary,
                                ellipsization="middle",
                            )
                            .build()
                            .add_style_class("summary")
                            .unwrap(),
                        ],
                        h_expand=True,
                        v_expand=True,
                    ).build(
                        lambda box, _: box.pack_end(
                            Button(
                                image=Image(
                                    icon_name="window-close-symbolic",
                                    icon_size=16,
                                ),
                                v_align="center",
                                h_align="end",
                                on_clicked=lambda *_: self._notification.close(),
                            ),
                            False,
                            False,
                            0,
                        )
                    ),
                    Label(
                        label=self._notification.body,
                        line_wrap="word-char",
                        v_align="start",
                        h_align="start",
                    )
                    .build()
                    .add_style_class("body")
                    .unwrap(),
                ],
                h_expand=True,
                v_expand=True,
            )
        )

        self.add(body_container)

        if actions := self._notification.actions:
            self.add(
                Box(
                    spacing=4,
                    orientation="h",
                    children=[
                        Button(
                            h_expand=True,
                            v_expand=True,
                            label=action.label,
                            on_clicked=lambda *_, action=action: action.invoke(),
                        )
                        for action in actions
                    ],
                )
            )

        self._notification.connect(
            "closed",
            lambda *_: (
                parent.remove(self) if (parent := self.get_parent()) else None,  # type: ignore
                self.destroy(),
            ),
        )

        invoke_repeater(
            NOTIFICATION_TIMEOUT,
            lambda: self._notification.close("expired"),
            initial_call=False,
        )

# --- CLASE VENTANA DE NOTIFICACIONES CORREGIDA (AUTO-EXPANDIBLE) ---
class NotificationWindow(Window):
    def __init__(self, notifs_service: Notifications, **kwargs):
        super().__init__(
            layer="overlay",
            title="fabric-notifications",
            anchor="top right",
            margin="45px 12px 10px 0px",  # Margen perfecto debajo de tu barra de Qtile
            exclusivity="none",           # Igual que el SidePanel para evitar bloqueos
            pass_through=True,
            visible=False,                # !!! ARRANCA INVISIBLE para que no quede la barrita negra !!!
            all_visible=False,
            **kwargs,
        )

        # Contenedor principal sin límites rígidos de tamaño
        self.viewport = Box(
            spacing=4,
            orientation="v",
            name="notification-viewport"
        )
        self.add(self.viewport)

        # Conectamos el servicio para inyectar los widgets y controlar la visibilidad
        notifs_service.connect(
            "notification-added",
            self.al_recibir_notificacion
        )

    def al_recibir_notificacion(self, servicio, nid):
        # 1. Creamos e inyectamos el widget de la notificación
        widget = NotificationWidget(
            cast(Notification, servicio.get_notification_from_id(nid))
        )
        self.viewport.add(widget)
        
        # 2. Conectamos un evento para ocultar la ventana si se vacía
        widget._notification.connect(
            "closed",
            lambda *_: self.verificar_vacio()
        )

        # 3. Forzamos a GTK a recalcular el tamaño real del contenido antes de mostrarlo
        self.viewport.show_all()
        self.show()

    def verificar_vacio(self):
        # Si ya no quedan notificaciones flotantes visibles en el contenedor, ocultamos la ventana
        if len(self.viewport.get_children()) <= 1:
            # Usamos GLib nativo de GNOME/GTK para el temporizador de ocultado
            from gi.repository import GLib
            GLib.timeout_add(100, self.hide)

if __name__ == "__main__":
    app = Application("notifications")

    notifs_service = Notifications()

    ruta_estilos_locales = get_relative_path("./style.css")
    def recargar_estilos_en_caliente(servicio, nid):
        app.set_stylesheet_from_string("")
        if os.path.exists(ruta_estilos_locales):
            app.set_stylesheet_from_file(ruta_estilos_locales)

    notifs_service.connect("notification-added", recargar_estilos_en_caliente)

    window = NotificationWindow(notifs_service)
    app.add_window(window)

    if os.path.exists(ruta_estilos_locales):
        app.set_stylesheet_from_file(ruta_estilos_locales)

    app.run()
